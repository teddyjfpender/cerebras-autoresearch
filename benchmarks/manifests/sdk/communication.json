{
  "schema_version": 1,
  "profiles": [
    {
      "id": "sdk.broadcast-row",
      "adapter": "sdk",
      "source_path": "benchmarks/row-col-broadcast",
      "family": "communication",
      "dimensions": {
        "payload": 5,
        "repeats": 2,
        "roi_width": 3,
        "roi_height": 3
      },
      "pe_grid": [
        5,
        5
      ],
      "precision": "fp32",
      "variants": [
        "baseline",
        "candidate"
      ],
      "validation": "upstream_reference",
      "metric": "upstream_cycles",
      "cycle_pattern": "cycles_send = ([0-9.eE+-]+) cycles",
      "success_pattern": "check E_hwl == B_ext",
      "compile": [
        "cslc",
        "src/layout.csl",
        "--arch=wse3",
        "--fabric-dims=12,7",
        "--fabric-offsets=4,1",
        "--params=width:5,height:5,pe_length:5,C0_ID:0,C1_ID:1,C2_ID:2,C3_ID:3,C4_ID:4",
        "-o",
        "out",
        "--memcpy",
        "--channels=1"
      ],
      "run": [
        "run.py",
        "-m=5",
        "-n=5",
        "-k=5",
        "--latestlink",
        "out",
        "--channels=1",
        "--loop_count=2",
        "--is_row_bcast"
      ],
      "work_units": 90,
      "work_unit": "delivered_elements",
      "description": "Pinned Cerebras SDK reference driver; full-suite candidate promotion requires an independent oracle.",
      "timeout_seconds": 600,
      "regression_limit": 1.02
    },
