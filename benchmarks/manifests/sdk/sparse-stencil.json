{
  "schema_version": 1,
  "profiles": [
    {
      "id": "sdk.spmv7",
      "adapter": "sdk",
      "source_path": "benchmarks/7pt-stencil-spmv",
      "shared_libraries": ["allreduce", "stencil_3d_7pts"],
      "family": "sparse-stencil",
      "dimensions": {
        "x": 5,
        "y": 5,
        "z": 5
      },
      "pe_grid": [
        5,
        5
      ],
      "precision": "fp32",
      "variants": [
        "baseline",
        "candidate"
      ],
      "validation": "upstream_reference",
      "metric": "upstream_cycles",
      "cycle_pattern": "cycles_send = ([0-9.eE+-]+) cycles",
      "success_pattern": "SUCCESS",
      "compile": [
        "cslc",
        "src/layout.csl",
        "--arch=wse3",
        "--fabric-dims=12,7",
        "--fabric-offsets=4,1",
        "--params=width:5,height:5,MAX_ZDIM:5,BLOCK_SIZE:2,C0_ID:0,C1_ID:1,C2_ID:2,C3_ID:3,C4_ID:4,C5_ID:5,C6_ID:6,C7_ID:7,C8_ID:8",
        "-o",
        "out",
        "--memcpy",
        "--channels=1"
      ],
      "run": [
        "run.py",
        "-m=5",
        "-n=5",
        "-k=5",
        "--latestlink",
        "out",
        "--channels=1",
        "--zDim=5",
        "--run-only",
        "--arch=wse3"
      ],
      "work_units": 125,
      "work_unit": "output_elements",
      "description": "Pinned Cerebras SDK reference driver; full-suite candidate promotion requires an independent oracle.",
      "timeout_seconds": 600,
      "regression_limit": 1.02
    }
  ]
}
