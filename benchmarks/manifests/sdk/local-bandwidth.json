{
  "schema_version": 1,
  "profiles": [
    {
      "id": "sdk.local-matvec",
      "adapter": "sdk",
      "source_path": "benchmarks/single-tile-matvec",
      "family": "local-bandwidth",
      "dimensions": {
        "tile": 25,
        "iterations": 1
      },
      "pe_grid": [
        2,
        2
      ],
      "precision": "fp32",
      "variants": [
        "baseline",
        "candidate"
      ],
      "validation": "upstream_reference",
      "metric": "upstream_cycles",
      "cycle_pattern": "Max cycles[^\\n:]*:\\s*([0-9.eE+-]+)",
      "success_pattern": "SUCCESS",
      "compile": [
        "cslc",
        "src/layout_matvec.csl",
        "--arch=wse3",
        "--fabric-dims=9,4",
        "--fabric-offsets=4,1",
        "--params=width:2,height:2,tile_size:25,iters:1",
        "-o",
        "out",
        "--memcpy",
        "--channels=1"
      ],
      "run": [
        "run.py",
        "--name",
        "out",
        "--verify"
      ],
      "work_units": 5000,
      "work_unit": "arithmetic_operations",
      "description": "Pinned Cerebras SDK reference driver; full-suite candidate promotion requires an independent oracle.",
      "timeout_seconds": 600,
      "regression_limit": 1.02
    }
  ]
}
