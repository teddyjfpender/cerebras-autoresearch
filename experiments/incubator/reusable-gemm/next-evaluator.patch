+
+
+class RecoveryTests(unittest.TestCase):
+    def setUp(self):
+        folder = tempfile.TemporaryDirectory()
+        self.addCleanup(folder.cleanup)
+        self.root = Path(folder.name).resolve()
+        mocked = patch("cerebras_research.ledger.ROOT", self.root)
+        mocked.start()
