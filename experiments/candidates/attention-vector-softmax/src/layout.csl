param P: i16;
param S: i16;
param D: i16;
param G: i16;
param T: i16;
param L: i16;
const memcpy = @import_module("<memcpy/get_params>", .{ .width = P, .height = 1 });
const c2d = @import_module("<collectives_2d/params>");
layout {
    @set_rectangle(P, 1);
    for (@range(i16, P)) |x| {
        const cp = c2d.get_params(@as(u16, x), 0, .{
            .x_colors = .{ @get_color(0), @get_color(1) },
            .x_entrypoints = .{ @get_local_task_id(14), @get_local_task_id(15) },
            .y_colors = .{ @get_color(4), @get_color(5) },
            .y_entrypoints = .{ @get_local_task_id(16), @get_local_task_id(17) },
        });
        @set_tile_code(x, 0, "pe.csl", .{
            .memcpy_params = memcpy.get_params(x), .c2d_params = cp,
            .P = P, .S = S, .D = D, .G = G, .T = T, .L = L,
        });
    }
    @export_name("Q", [*]f32, true);
    @export_name("NEW_K", [*]f32, true);
    @export_name("NEW_V", [*]f32, true);
    @export_name("K", [*]f32, true);
    @export_name("V", [*]f32, true);
    @export_name("Y", [*]f32, false);
    @export_name("times", [*]u16, false);
    @export_name("compute", fn()void);
}
