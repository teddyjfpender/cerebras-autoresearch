// Resident FP32 matvec -> bias -> ReLU -> residual benchmark.
param K: i16;
param N: i16;
param FUSED: i16;
const memcpy = @import_module("<memcpy/get_params>", .{ .width = 1, .height = 1 });
layout {
    @set_rectangle(1, 1);
    @set_tile_code(0, 0, "pe.csl", .{ .memcpy_params = memcpy.get_params(0), .K = K, .N = N, .FUSED = FUSED });
    @export_name("X", [*]f32, true);
    @export_name("W", [*]f32, true);
    @export_name("B", [*]f32, true);
    @export_name("R", [*]f32, true);
    @export_name("Y", [*]f32, false);
    @export_name("times", [*]u16, false);
    @export_name("compute", fn()void);
}
