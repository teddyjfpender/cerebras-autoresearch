        if (D > 100) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[100]); }
        if (D > 101) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[101]); }
        if (D > 102) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[102]); }
        if (D > 103) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[103]); }
        if (D > 104) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[104]); }
        if (D > 105) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[105]); }
        if (D > 106) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[106]); }
        if (D > 107) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[107]); }
        if (D > 108) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[108]); }
        if (D > 109) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[109]); }
        if (D > 110) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[110]); }
        if (D > 111) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[111]); }
        if (D > 112) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[112]); }
        if (D > 113) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[113]); }
        if (D > 114) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[114]); }
        if (D > 115) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[115]); }
        if (D > 116) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[116]); }
        if (D > 117) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[117]); }
        if (D > 118) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[118]); }
        if (D > 119) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[119]); }
        if (D > 120) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[120]); }
        if (D > 121) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[121]); }
        if (D > 122) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[122]); }
        if (D > 123) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[123]); }
        if (D > 124) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[124]); }
        if (D > 125) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[125]); }
        if (D > 126) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[126]); }
        if (D > 127) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[127]); }
        const destination = @increment_dsd_offset(score_dsd, head*S, f32);
        @fmovs(destination, logits);
    }
}

fn make_partial() void {
    var head: i16 = 0;
    while (head < G) : (head += 1) {
        var denominator: f32 = 0.0;
        var local_weights = @increment_dsd_offset(weight_dsd, head*S, f32);
        @fmovs(local_weights, 0.0);
        var slot: i16 = 0;
        if (S == 4) {
            const shift: f32 = global_max[head];
            if (valid > 0) {
                const w: f32 = attention_exp(scores[head*S+0] - shift);
                weights[head*S+0] = w;
                denominator += w;
            }
            if (valid > 1) {
                const w: f32 = attention_exp(scores[head*S+1] - shift);
                weights[head*S+1] = w;
                denominator += w;
            }
            if (valid > 2) {
                const w: f32 = attention_exp(scores[head*S+2] - shift);
                weights[head*S+2] = w;
                denominator += w;
            }
            if (valid > 3) {
                const w: f32 = attention_exp(scores[head*S+3] - shift);
                weights[head*S+3] = w;
                denominator += w;
            }
        } else {
            while (slot < valid) : (slot += 1) {
                const w: f32 = attention_exp(scores[head*S+slot] - global_max[head]);
                weights[head*S+slot] = w;
                denominator += w;
            }
        }
        partial[head*R] = denominator;
        var numerator = @increment_dsd_offset(num_dsd, head*R+1, f32);
        var values = @set_dsd_base_addr(value_dsd, &V);
        @fmovs(numerator, 0.0);
        @load_to_dsr(compute_dest, numerator, .{ .save_address = false });
        @load_to_dsr(compute_src0, numerator, .{ .save_address = false });
        if (S > 0) {
            if (valid > 0) {
                const vector = @increment_dsd_offset(values, 0, f32);
                @load_to_dsr(compute_src1, vector, .{ .save_address = false });
                @fmacs(compute_dest, compute_src0, compute_src1, weights[head*S+0]);
            }
        }
        if (S > 1) {
            if (valid > 1) {
                const vector = @increment_dsd_offset(values, 1, f32);
                @load_to_dsr(compute_src1, vector, .{ .save_address = false });
                @fmacs(compute_dest, compute_src0, compute_src1, weights[head*S+1]);
            }
        }
        if (S > 2) {
            if (valid > 2) {
                const vector = @increment_dsd_offset(values, 2, f32);
                @load_to_dsr(compute_src1, vector, .{ .save_address = false });
                @fmacs(compute_dest, compute_src0, compute_src1, weights[head*S+2]);
            }
        }
        if (S > 3) {
            if (valid > 3) {
                const vector = @increment_dsd_offset(values, 3, f32);
                @load_to_dsr(compute_src1, vector, .{ .save_address = false });
                @fmacs(compute_dest, compute_src0, compute_src1, weights[head*S+3]);
            }
        }
        if (S > 4) {
            if (valid > 4) {
                const vector = @increment_dsd_offset(values, 4, f32);
                @load_to_dsr(compute_src1, vector, .{ .save_address = false });
                @fmacs(compute_dest, compute_src0, compute_src1, weights[head*S+4]);
            }
        }
        if (S > 5) {
            if (valid > 5) {
                const vector = @increment_dsd_offset(values, 5, f32);
                @load_to_dsr(compute_src1, vector, .{ .save_address = false });
                @fmacs(compute_dest, compute_src0, compute_src1, weights[head*S+5]);
            }
        }
        if (S > 6) {
            if (valid > 6) {
                const vector = @increment_dsd_offset(values, 6, f32);
                @load_to_dsr(compute_src1, vector, .{ .save_address = false });
                @fmacs(compute_dest, compute_src0, compute_src1, weights[head*S+6]);
            }
        }
        if (S > 7) {
            if (valid > 7) {
                const vector = @increment_dsd_offset(values, 7, f32);
                @load_to_dsr(compute_src1, vector, .{ .save_address = false });
                @fmacs(compute_dest, compute_src0, compute_src1, weights[head*S+7]);
            }
        }
        if (S > 8) {
            if (valid > 8) {
                const vector = @increment_dsd_offset(values, 8, f32);
                @load_to_dsr(compute_src1, vector, .{ .save_address = false });
                @fmacs(compute_dest, compute_src0, compute_src1, weights[head*S+8]);
            }
        }
        if (S > 9) {
            if (valid > 9) {
                const vector = @increment_dsd_offset(values, 9, f32);
                @load_to_dsr(compute_src1, vector, .{ .save_address = false });
                @fmacs(compute_dest, compute_src0, compute_src1, weights[head*S+9]);
            }
        }
        if (S > 10) {
            if (valid > 10) {
                const vector = @increment_dsd_offset(values, 10, f32);
                @load_to_dsr(compute_src1, vector, .{ .save_address = false });
                @fmacs(compute_dest, compute_src0, compute_src1, weights[head*S+10]);
            }
        }
        if (S > 11) {
            if (valid > 11) {
                const vector = @increment_dsd_offset(values, 11, f32);
                @load_to_dsr(compute_src1, vector, .{ .save_address = false });
                @fmacs(compute_dest, compute_src0, compute_src1, weights[head*S+11]);
            }
        }
        if (S > 12) {
            if (valid > 12) {
                const vector = @increment_dsd_offset(values, 12, f32);
                @load_to_dsr(compute_src1, vector, .{ .save_address = false });
                @fmacs(compute_dest, compute_src0, compute_src1, weights[head*S+12]);
            }
        }
        if (S > 13) {
            if (valid > 13) {
                const vector = @increment_dsd_offset(values, 13, f32);
                @load_to_dsr(compute_src1, vector, .{ .save_address = false });
                @fmacs(compute_dest, compute_src0, compute_src1, weights[head*S+13]);
