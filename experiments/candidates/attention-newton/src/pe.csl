// Resident GQA decode: vector reference, one dispatch plus three collectives/token.
// Same SDK collectives API as the Apache-2.0 example cited in layout.csl.
param memcpy_params;
param c2d_params;
param P: i16;
param S: i16;
param D: i16;
param G: i16;
param T: i16;
param L: i16;
const sys = @import_module("<memcpy/memcpy>", memcpy_params);
const mpi = @import_module("<collectives_2d/pe>", .{ .dim_params = c2d_params.x });
const clock = @import_module("<time>");
const math = @import_module("<math>");
const BEGIN: local_task_id = @get_local_task_id(9);
const MAXIMA: local_task_id = @get_local_task_id(10);
const PARTIAL: local_task_id = @get_local_task_id(11);
const OUTPUT: local_task_id = @get_local_task_id(12);
const ROOT: u16 = @as(u16, P-1);
const R: i16 = D+1;
var Q: [T*G*D]f32;
var NEW_K: [T*D]f32;
var NEW_V: [T*D]f32;
// Dimension-major cache permits vector operations over the local context.
var K: [D*S]f32;
var V: [D*S]f32;
var Y: [T*G*D]f32;
var ptr_Q: [*]f32 = &Q;
var ptr_NEW_K: [*]f32 = &NEW_K;
var ptr_NEW_V: [*]f32 = &NEW_V;
var ptr_K: [*]f32 = &K;
var ptr_V: [*]f32 = &V;
const ptr_Y: [*]f32 = &Y;
var scores: [G*S]f32;
var weights: [G*S]f32;
var local_max: [G]f32;
var all_max: [P*G]f32;
var global_max: [G]f32;
var partial: [G*R]f32;
var merged: [G*R]f32;
var flag = @zeros([1]u32);
var step: i16 = 0;
var valid: i16 = 0;
var px: i16 = 0;
var begin = @zeros([3]u16);
var end = @zeros([3]u16);
var times = @zeros([6]u16);
const ptr_times: [*]u16 = &times;
var score_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{S} -> scores[i] });
var weight_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{S} -> weights[i] });
var key_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{S} -> K[i] });
var value_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{D} -> V[i*S] });
var num_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{D} -> partial[i] });

// BEGIN LOCAL COMPUTE: candidate edits are confined to this region.
fn attention_exp(x: f32) f32 { return math.exp(x); }

var bank_logits: [S+1]f32 align(16);
var scaled_query: [D]f32 align(16);
var max_scratch: [G+1]f32 align(16);
const compute_dest = @get_dsr(dsr_dest, 2);
const compute_src0 = @get_dsr(dsr_src0, 2);
const compute_src1 = @get_dsr(dsr_src1, 2);
fn qk_step(q: f32, inv_scale: f32) void {
    @fmacs(compute_dest, compute_src0, compute_src1, q * inv_scale);
}

fn make_logits() void {
    @comptime_assert(S <= 32);
    @comptime_assert(D <= 128);
    const inv_scale: f32 = if (D == 64) 0.125 else 0.08838834764831845;
    var head: i16 = 0;
    while (head < G) : (head += 1) {
        var logits = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{S} -> bank_logits[i+1] });
        var keys = @set_dsd_base_addr(key_dsd, &K);
        @fmovs(logits, 0.0);
        @load_to_dsr(compute_dest, logits, .{ .save_address = false });
        @load_to_dsr(compute_src0, logits, .{ .save_address = false });
        @load_to_dsr(compute_src1, keys, .{ .save_address = true });
        var queries = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{D} -> Q[i] });
        queries = @increment_dsd_offset(queries, (step*G+head)*D, f32);
        const scaled = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{D} -> scaled_query[i] });
        @fmuls(scaled, queries, inv_scale);
        if (D > 0) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[0]); }
        if (D > 1) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[1]); }
        if (D > 2) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[2]); }
        if (D > 3) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[3]); }
        if (D > 4) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[4]); }
        if (D > 5) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[5]); }
        if (D > 6) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[6]); }
        if (D > 7) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[7]); }
        if (D > 8) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[8]); }
        if (D > 9) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[9]); }
        if (D > 10) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[10]); }
        if (D > 11) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[11]); }
        if (D > 12) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[12]); }
        if (D > 13) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[13]); }
        if (D > 14) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[14]); }
        if (D > 15) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[15]); }
        if (D > 16) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[16]); }
        if (D > 17) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[17]); }
        if (D > 18) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[18]); }
        if (D > 19) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[19]); }
        if (D > 20) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[20]); }
        if (D > 21) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[21]); }
        if (D > 22) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[22]); }
        if (D > 23) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[23]); }
        if (D > 24) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[24]); }
        if (D > 25) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[25]); }
        if (D > 26) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[26]); }
        if (D > 27) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[27]); }
        if (D > 28) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[28]); }
        if (D > 29) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[29]); }
        if (D > 30) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[30]); }
        if (D > 31) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[31]); }
        if (D > 32) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[32]); }
        if (D > 33) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[33]); }
