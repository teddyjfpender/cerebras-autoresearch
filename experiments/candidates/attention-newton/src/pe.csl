        if (D > 62) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[62]); }
        if (D > 63) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[63]); }
        if (D > 64) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[64]); }
        if (D > 65) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[65]); }
