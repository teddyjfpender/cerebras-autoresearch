// For normal positive x, the bit-linear seed has at most 1/8 relative error.
// Four FP32 Newton steps square that error repeatedly. Stable-softmax sums
// are finite and in [1, context] by construction; the supported context is
// at most 4096, safely inside the host-checked [1,8192] range.
fn positive_reciprocal(x: f32) f32 {
    var y: f32 = @bitcast(f32, @as(u32, 0x7f000000) - @bitcast(u32, x));
    y = y * (2.0 - x*y);
    y = y * (2.0 - x*y);
    y = y * (2.0 - x*y);
    return y * (2.0 - x*y);
}

fn store_output() void {
    var head: i16 = 0;
    while (head < G) : (head += 1) {
        const inv_denominator: f32 = positive_reciprocal(merged[head*R]);
        var output = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{D} -> Y[i] });
        var numerator = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{D} -> merged[i] });
        output = @increment_dsd_offset(output, (step*G+head)*D, f32);
        numerator = @increment_dsd_offset(numerator, head*R+1, f32);
        @fmuls(output, numerator, inv_denominator);
    }
}
fn merge_maxima() void {
    const maximum = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{G} -> max_scratch[i+1] });
    const gathered = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{G} -> all_max[i] });
    const output = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{G} -> global_max[i] });
    @fmovs(maximum, -3.4e38);
    @load_to_dsr(compute_dest, maximum, .{ .save_address = false });
    @load_to_dsr(compute_src0, maximum, .{ .save_address = false });
    @load_to_dsr(compute_src1, gathered, .{ .save_address = true });
    @comptime_assert(P <= 128);
