        if (D > 69) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[69]); }
        if (D > 70) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[70]); }
        if (D > 71) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[71]); }
        if (D > 72) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[72]); }
        if (D > 73) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[73]); }
        if (D > 74) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[74]); }
        if (D > 75) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[75]); }
        if (D > 76) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[76]); }
        if (D > 77) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[77]); }
        if (D > 78) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[78]); }
        if (D > 79) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[79]); }
        if (D > 80) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[80]); }
        if (D > 81) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[81]); }
        if (D > 82) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[82]); }
        if (D > 83) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[83]); }
        if (D > 84) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[84]); }
        if (D > 85) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[85]); }
        if (D > 86) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[86]); }
        if (D > 87) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[87]); }
        if (D > 88) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[88]); }
        if (D > 89) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[89]); }
        if (D > 90) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[90]); }
        if (D > 91) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[91]); }
        if (D > 92) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[92]); }
        if (D > 93) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[93]); }
        if (D > 94) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[94]); }
        if (D > 95) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[95]); }
        if (D > 96) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[96]); }
        if (D > 97) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[97]); }
