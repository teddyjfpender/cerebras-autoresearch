        if (D > 42) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[42]); }
        if (D > 43) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[43]); }
        if (D > 44) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[44]); }
        if (D > 45) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[45]); }
        if (D > 46) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[46]); }
        if (D > 47) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[47]); }
        if (D > 48) { @fmacs(compute_dest, compute_src0, compute_src1, scaled_query[48]); }
